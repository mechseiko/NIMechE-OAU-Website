# ─────────────────────────────────────────────────────────────────────────────
# NIMechE OAU-SC website — environment variables
# Copy to `.env.local` and fill in. The app boots in a read-only
# "unconfigured" state until these are present; nothing else is required.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Web App config  (Firebase Console → Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudinary  (Console → Dashboard). Used for every image / document upload
# (candidate portraits, news covers, gallery, resource PDFs…).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — absolute origin used in metadata / OG tags (defaults to localhost in dev)
NEXT_PUBLIC_SITE_URL=
